{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CoVayAICostAuditSchema",
  "description": "Schema for CoVayAI training cost, throughput, and hardware efficiency reports",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "ISO-8601 timestamp of benchmark run"
    },
    "git_sha": {
      "type": "string",
      "description": "Git commit SHA"
    },
    "branch": {
      "type": "string",
      "description": "Git active branch"
    },
    "hardware": {
      "type": "object",
      "properties": {
        "os": { "type": "string" },
        "cpu": { "type": "string" },
        "ram_gb": { "type": "number" },
        "gpu": { "type": "string" },
        "vram_gb": { "type": "number" },
        "torch_version": { "type": "string" },
        "cuda_version": { "type": "string" }
      }
    },
    "configuration": {
      "type": "object",
      "properties": {
        "board_size": { "type": "integer", "enum": [5, 9, 13, 19] },
        "network_arch": { "type": "string" },
        "num_blocks": { "type": "integer" },
        "num_filters": { "type": "integer" },
        "mcts_sims": { "type": "integer" },
        "num_actors": { "type": "integer" },
        "infer_batch": { "type": "integer" },
        "train_batch": { "type": "integer" }
      }
    },
    "total_running_hours": {
      "type": "number",
      "minimum": 0.0,
      "description": "Total wall-clock duration in hours"
    },
    "gpu_hours": {
      "type": "number",
      "minimum": 0.0,
      "description": "Hours GPU was actively running/leased"
    },
    "gpu_price_per_hour": {
      "type": "number",
      "minimum": 0.0,
      "description": "Price per GPU-hour in USD or currency unit"
    },
    "electricity_kwh": {
      "type": "number",
      "minimum": 0.0,
      "description": "Total electricity consumed in kWh"
    },
    "electricity_tariff": {
      "type": "number",
      "minimum": 0.0,
      "description": "Cost per kWh"
    },
    "storage_fees": {
      "type": "number",
      "minimum": 0.0,
      "description": "Cloud disk or snapshot storage costs"
    },
    "other_fees": {
      "type": "number",
      "minimum": 0.0,
      "description": "Data transfer or other incidental fees"
    },
    "completed_games": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of naturally completed self-play games"
    },
    "valid_training_positions": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of valid state positions generated for training"
    },
    "full_search_positions": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of high-quality full-search positions saved"
    },
    "nn_evals": {
      "type": "integer",
      "minimum": 0,
      "description": "Total neural network evaluations executed"
    },
    "total_compute_cost": {
      "type": "number",
      "minimum": 0.0
    },
    "cost_per_1k_completed_games": {
      "type": ["number", "string"]
    },
    "cost_per_1k_valid_positions": {
      "type": ["number", "string"]
    },
    "cost_per_1k_full_search_positions": {
      "type": ["number", "string"]
    },
    "cost_per_1m_nn_evals": {
      "type": ["number", "string"]
    }
  },
  "required": [
    "total_running_hours",
    "completed_games"
  ]
}
